# ─────────────────────────────────────────────────────────────────────────────
#  Makefile.snes — Super Nintendo target (4 MB HiROM / FastROM, no chips)
#
#      make -f Makefile.snes            # -> build/snes/waifusnes.sfc (retail)
#      make -f Makefile.snes DEBUG=1    # -> build/snes/waifusnes_debug.sfc
#      make -f Makefile.snes verify     # build both, then run the harness
#
#  THE RETAIL ROM HAS NO SWITCHES.  The harness drives the duel through four
#  pad shortcuts (R fixture board, SELECT no cards, L demo, Y pinned camera)
#  and the title through three (Y deck, B story, X ending); a cartridge that
#  answered them would be a cartridge that plays itself on a pressed
#  shoulder.  DEBUG=1 compiles them in (-DSNES_DEBUG) into a ROM of its own
#  name, built from its own object tree, and tools/snes/verify.py runs THAT
#  one -- the retail ROM gets the header and freshness checks only.
#
#  Laid out as a fork the way Makefile.msx2 and Makefile.atarist are:
#  everything target specific is in src/snes/ and tools/snes/, and src/main.c
#  is never compiled here.  See SNES_PORT_PLAN.md.
#
#  This deliberately does NOT include pvsneslib's devkitsnes/snes_rules.  That
#  file wildcards $(SRC)/*.c and drops every intermediate next to the source,
#  which for this repository would sweep in src/main.c, src/msx2/ and
#  src/atarist/ and scatter .ps/.asm/.obj through the tree.  The three tool
#  invocations it wraps (816-tcc -> 816-opt -> wla-65816 -> wlalink) are short
#  enough to spell out, and spelling them out is what lets the object tree live
#  under build/snes/ and the bank layout be checked.
# ─────────────────────────────────────────────────────────────────────────────

.DEFAULT_GOAL := all

PVSNESLIB_HOME ?= $(CURDIR)/SNES/pvsneslib
SNESFAUST      ?= $(CURDIR)/SNES/snesfaust/snesfaust-mednafen

CC      := $(PVSNESLIB_HOME)/devkitsnes/bin/816-tcc
AS      := $(PVSNESLIB_HOME)/devkitsnes/bin/wla-65816
LD      := $(PVSNESLIB_HOME)/devkitsnes/bin/wlalink
OPT     := $(PVSNESLIB_HOME)/devkitsnes/tools/816-opt
LIBDIR  := $(PVSNESLIB_HOME)/pvsneslib/lib/HiROM_FastROM

PROJ_DIR := src/snes
BUILD    := build/snes
DEBUG    ?= 0
ifeq ($(DEBUG),1)
OBJ      := $(BUILD)/obj_debug
ROM      := $(BUILD)/waifusnes_debug.sfc
else
OBJ      := $(BUILD)/obj
ROM      := $(BUILD)/waifusnes.sfc
endif

# ── Cartridge shape (SNES_PORT_PLAN.md §1.1) ─────────────────────────────────
# 4 MB is the largest chipless ROM that is FastROM everywhere: ExHiROM's upper
# 4 MB lands in banks $40-$7D, which are SlowROM on every SNES.
ROMTITLE      := SHATTERED DECKS
CARTRIDGETYPE := 02
ROMSIZE       := 0C
SRAMSIZE      := 03
COUNTRY       := 01
LICENSEECODE  := 00
VERSION       := 00
ROMBANKS      := 64

HDR := $(OBJ)/hdr.asm

# ── Sources ──────────────────────────────────────────────────────────────────
# The fork.
SNES_C   := $(sort $(wildcard $(PROJ_DIR)/*.c))
SNES_ASM := $(sort $(wildcard $(PROJ_DIR)/*.asm)) \
            $(sort $(wildcard $(PROJ_DIR)/assets/*.asm))
# The C and hand-written assembly halves share the audio stem.  Keep the
# source name readable, but give its object a distinct basename because this
# Makefile deliberately flattens objects from multiple source directories.
SNES_AUDIO_ASM := $(PROJ_DIR)/snes_audio.asm
SNES_AUDIO_ASSETS_ASM := $(PROJ_DIR)/assets/snes_audio.asm
SNES_ASM := $(filter-out $(SNES_AUDIO_ASM) $(SNES_AUDIO_ASSETS_ASM),$(SNES_ASM))
SNES_AUDIO_OBJ := $(OBJ)/snes_audio_hw.obj
SNES_AUDIO_ASSETS_OBJ := $(OBJ)/snes_audio_assets.obj
# These generated sources are explicit because they may not exist yet when
# make expands the wildcard above.  The stamp recipe emits all three banks,
# their INCBIN blobs, and snes_obj_data.h in one deterministic generator run.
SNES_OBJ_ASM := $(PROJ_DIR)/assets/snes_objassets.asm \
                $(PROJ_DIR)/assets/snes_sprcards.asm \
                $(PROJ_DIR)/assets/snes_sprcardshi.asm \
                $(PROJ_DIR)/assets/snes_bigcard_common.asm \
                $(foreach b,$(shell seq 30 49),$(PROJ_DIR)/assets/snes_bigcards_$(b).asm)
SNES_ASM := $(sort $(SNES_ASM) $(SNES_OBJ_ASM))
SNES_SCENE_ASM := $(PROJ_DIR)/assets/snes_title.asm \
                  $(PROJ_DIR)/assets/snes_story.asm \
                  $(PROJ_DIR)/assets/snes_ending.asm \
                  $(PROJ_DIR)/assets/snes_sceneassets.asm \
                  $(PROJ_DIR)/assets/snes_portraits.asm
SNES_ASM := $(sort $(SNES_ASM) $(SNES_SCENE_ASM))
SNES_FX_ASM := $(PROJ_DIR)/assets/snes_battlefx.asm
SNES_ASM := $(sort $(SNES_ASM) $(SNES_FX_ASM))
SNES_DECK_ASM := $(PROJ_DIR)/assets/snes_deckui.asm \
                 $(PROJ_DIR)/assets/snes_deckicons_4.asm \
                 $(PROJ_DIR)/assets/snes_deckicons_5.asm
SNES_ASM := $(sort $(SNES_ASM) $(SNES_DECK_ASM))
SNES_PLANAR_ASM := $(foreach p,0 1,$(PROJ_DIR)/assets/snes_floor_chunky_$(p).asm $(PROJ_DIR)/assets/snes_floor_planar_$(p).asm) \
 $(foreach t,p0_h0 p1_h0 p2_h0 p3_h0 p3_h1,$(PROJ_DIR)/assets/snes_pairlut_$(t).asm) \
 $(foreach p,0 1 2 3,$(PROJ_DIR)/assets/snes_dbl2lut_p$(p).asm) \
 $(foreach p,0 1 2 3,$(PROJ_DIR)/assets/snes_dbl2lut4_p$(p).asm) \
 $(PROJ_DIR)/assets/snes_texlut.asm
SNES_RENDER_ASM := $(SNES_PLANAR_ASM) $(PROJ_DIR)/snes_conv_gen.asm \
 $(PROJ_DIR)/snes_tables.asm $(PROJ_DIR)/assets/snes_cards.asm \
 $(PROJ_DIR)/assets/snes_cards32.asm $(PROJ_DIR)/assets/snes_cards32b.asm
SNES_ASM := $(sort $(SNES_ASM) $(SNES_RENDER_ASM))

# Compiled in unchanged: the render-free duel rules and the shared AI/decks.
SHARED_C := src/msx2/msx2_duel.c src/msx2/msx2_cards.c \
            src/game/ai.c src/game/deck.c

# A small cartridge exercising the real CPU/SPC driver independently of menus.
ifeq ($(SNES_AUDIO_PROBE),1)
SNES_C := tools/snes/audio_probe.c $(PROJ_DIR)/snes_audio_driver.c
SNES_ASM :=
SHARED_C :=
endif

CFILES := $(SNES_C) $(SHARED_C)

# EVERY OBJECT DEPENDS ON EVERY HEADER, and the bluntness is deliberate.  There
# is no dependency generation here, and the first time a header changed without
# one -- a word added to the frame stamp -- half the build kept the old struct
# and wrote its checksum over the new field, which reads exactly like a crash.
# Forty source files rebuild in a couple of seconds; that trade is not close.
HEADERS := $(wildcard $(PROJ_DIR)/*.h) $(wildcard $(PROJ_DIR)/compat/*.h) \
           $(wildcard src/msx2/*.h) $(wildcard src/game/*.h)
ifeq ($(SNES_AUDIO_PROBE),1)
HEADERS := $(PROJ_DIR)/snes_audio.h $(PROJ_DIR)/snes_audio_layout.h \
           $(PROJ_DIR)/snes_types.h
endif
# compat/ is first so src/msx2/msx2_duel.c finds the msxgl.h shim, and
# src/game/*.c the waifu_assets.h one, without either file being edited.
CFLAGS := -I$(PROJ_DIR)/compat -I$(PROJ_DIR) -Isrc/game -Isrc/msx2 -Isrc/generated \
          -I$(PVSNESLIB_HOME)/pvsneslib/include \
          -I$(PVSNESLIB_HOME)/devkitsnes/include \
          -DWAIFU_SNES=1
# -H HiROM, -F FastROM: they pick the calling/addressing model, so they must
# agree with LIBDIR or the link silently mixes two ABIs.
CFLAGS += -H -F
ifeq ($(DEBUG),1)
CFLAGS += -DSNES_DEBUG=1
endif

# assets/ is on the include path because the generated .asm there .INCBINs a
# .bin next to itself, and wla-dx resolves an INCBIN against its include dirs.
ASFLAGS := -d -s -x -I $(OBJ) -I $(PROJ_DIR)/assets -I $(PROJ_DIR)

OBJS := $(patsubst %.c,$(OBJ)/%.obj,$(notdir $(CFILES))) \
        $(patsubst %.asm,$(OBJ)/%.obj,$(notdir $(SNES_ASM))) \
        $(SNES_AUDIO_OBJ) $(SNES_AUDIO_ASSETS_OBJ)

# Two source trees feed one flat object dir, so tell make where to look.
vpath %.c $(PROJ_DIR) src/msx2 src/game tools/snes
vpath %.asm $(PROJ_DIR) $(PROJ_DIR)/assets

.PHONY: all rom verify clean check-sdk banks obj-assets audio-assets

all: rom

check-sdk:
	@test -x "$(CC)" || { \
	  echo "pvsneslib is not built.  Run:"; \
	  echo "    cd SNES/pvsneslib && git submodule update --init --depth 1"; \
	  echo "    make -j all && PVSNESLIB_HOME=\$$PWD make -C pvsneslib"; \
	  exit 1; }
	@test -d "$(LIBDIR)" || { echo "missing $(LIBDIR)"; exit 1; }

rom: check-sdk $(ROM)

# ── The header ───────────────────────────────────────────────────────────────
# Generated from pvsneslib's template with our cartridge shape substituted in,
# which is what snes_rules does; every object .include's it, so it is also the
# memory map every section is placed against.
$(HDR): $(PVSNESLIB_HOME)/devkitsnes/include/hdr.asm.in Makefile.snes
	@mkdir -p $(dir $@)
	@sed -e 's/@HIROMDEF@/.DEFINE HIROM 1/' \
	     -e 's/@FASTROMDEF@/.DEFINE FASTROM 1/' \
	     -e 's/@ROMTITLE@/$(ROMTITLE)/' \
	     -e 's/@CARTRIDGETYPE@/$(CARTRIDGETYPE)/' \
	     -e 's/@ROMSIZE@/$(ROMSIZE)/' \
	     -e 's/@SRAMSIZE@/$(SRAMSIZE)/' \
	     -e 's/@COUNTRY@/$(COUNTRY)/' \
	     -e 's/@LICENSEECODE@/$(LICENSEECODE)/' \
	     -e 's/@VERSION@/$(VERSION)/' \
	     -e 's/@ROMBANKS@/$(ROMBANKS)/' \
	     -e 's/@ROMBANKSIZE@/10000/' \
	     -e 's/@ROMMODE@/HIROM/' \
	     -e 's/@ROMSPEED@/FASTROM/' \
	     $< > $@

# ── Compile ──────────────────────────────────────────────────────────────────
# 816-tcc emits WLA assembly (.ps), 816-opt peepholes it, wla-65816 assembles.
$(OBJ)/%.ps: %.c $(HDR) $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Wall -c $< -o $@

$(OBJ)/%.asm: $(OBJ)/%.ps
	$(OPT) -i $< -o $@

$(OBJ)/%.obj: $(OBJ)/%.asm
	$(AS) $(ASFLAGS) -o $@ $<

# Hand-written 65816 assembles straight; it lives in src/snes/ so the object
# rule above would try to find it in $(OBJ), hence its own pair of rules.
$(OBJ)/%.obj: $(PROJ_DIR)/%.asm $(HDR)
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) -o $@ $<

$(OBJ)/%.obj: $(PROJ_DIR)/assets/%.asm $(HDR)
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) -o $@ $<

# The converter drivers are .INCLUDEd into the generated converter, and both
# share the ring's constants with snes_fb.asm.
$(OBJ)/snes_conv_gen.obj: $(PROJ_DIR)/snes_conv_drivers.inc $(PROJ_DIR)/snes_fb.inc
$(OBJ)/snes_fb.obj: $(PROJ_DIR)/snes_fb.inc
# The fast direct-page map is shared by every hot loop.
$(OBJ)/snes_raster.obj $(OBJ)/snes_oam.obj $(OBJ)/snes_conv_gen.obj $(OBJ)/snes_fb.obj: $(PROJ_DIR)/snes_fastdp.inc
# The sprite emitters read the generated glyph-sheet numbers.
$(OBJ)/snes_oam.obj: $(PROJ_DIR)/snes_obj_data.inc
$(PROJ_DIR)/snes_obj_data.inc: $(SNES_OBJ_STAMP)
$(PROJ_DIR)/snes_conv_gen.asm: tools/snes/gen_snes_conv.py
	python3 tools/snes/gen_snes_conv.py

$(SNES_AUDIO_OBJ): $(SNES_AUDIO_ASM) $(HDR) $(PROJ_DIR)/snes_audio_layout.inc
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) -o $@ $<

SNES_AUDIO_SNAPSHOTS := $(addprefix $(PROJ_DIR)/assets/audio/,titlealt.spc overworld.spc altbattle.spc victory.spc fail.spc)
SNES_AUDIO_LAYOUTS := $(PROJ_DIR)/snes_audio_layout.h $(PROJ_DIR)/snes_audio_layout.inc
SNES_AUDIO_INPUTS := tools/snes/gen_snes_audio.py tools/snes/snes_sfx_brr2.py \
	tools/gen_sound_assets.py src/game/sounds.h \
	snes_music/midi/TitleAlt.midi snes_music/midi/Overworld.midi \
	snes_music/midi/AltBattle.midi snes_music/midi/Victory.midi \
	snes_music/midi/Fail.midi \
	$(wildcard sounds/new/*.wav) sounds/Select.wav \
	$(wildcard snes_music/MIDI2SPC_v23_altbattle_decrackle_release/source/c_transcriber/tools/*.py) \
	snes_music/MMX\ Revised/MMX1.sf2 snes_music/MMX_spc
SNES_AUDIO_STAMP := $(BUILD)/audio-assets.stamp

audio-assets: $(SNES_AUDIO_STAMP)

$(SNES_AUDIO_STAMP): $(SNES_AUDIO_INPUTS)
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_audio.py
	@touch $@

$(SNES_AUDIO_SNAPSHOTS) $(SNES_AUDIO_LAYOUTS): $(SNES_AUDIO_STAMP)

SNES_OBJ_INPUTS := tools/snes/gen_snes_obj.py tools/snes/gen_snes_bigcards.py \
	tools/atarist/gen_atarist_assets.py src/engine/font_menudata.h \
	src/generated/waifu_assets.h \
	$(wildcard assets/source/cards/*) \
	$(wildcard assets/source/textures/*)
SNES_OBJ_STAMP := $(BUILD)/obj-assets.stamp
SNES_SCENE_INPUTS := tools/snes/gen_snes_scenes.py \
	tools/snes/gen_snes_dialogue.py src/main.c \
	src/engine/font_menudata.h assets/source/title/title256.png \
	$(wildcard assets/source/bg/*.png) \
	$(wildcard assets/source/story_portraits/pixelart/*.png) \
	assets/source/ending/ending256x240.png
SNES_SCENE_STAMP := $(BUILD)/scene-assets.stamp

# Generators also write headers consumed by C.  Make these normal prerequisites
# so a parallel build waits for generation and recompiles after asset changes.
ifneq ($(SNES_AUDIO_PROBE),1)
$(patsubst %.c,$(OBJ)/%.ps,$(notdir $(CFILES))): $(SNES_OBJ_STAMP) $(SNES_SCENE_STAMP) $(BUILD)/planar-assets.stamp $(BUILD)/card-assets.stamp $(BUILD)/fx-assets.stamp $(BUILD)/deck-assets.stamp
endif

# The deck editor's baked panel and the PC-FX mini card icons in direct
# colour, and snes_deck_data.h.
SNES_DECK_INPUTS := tools/snes/gen_snes_deck.py tools/snes/gen_snes_bigcards.py \
	src/generated/waifu_assets.h assets/generated/card_faces.bin \
	assets/generated/support_face.bin
$(BUILD)/deck-assets.stamp: $(SNES_DECK_INPUTS)
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_deck.py
	@touch $@
$(SNES_DECK_ASM) $(PROJ_DIR)/snes_deck_data.h: $(BUILD)/deck-assets.stamp
$(patsubst $(PROJ_DIR)/assets/%.asm,$(OBJ)/%.obj,$(SNES_DECK_ASM)): $(BUILD)/deck-assets.stamp

# The battle's effects atlas, palettes and 2bpp font, and snes_battle_data.h.
$(BUILD)/fx-assets.stamp: tools/snes/gen_snes_battle_fx.py tools/snes/gen_snes_scenes.py src/engine/font_menudata.h
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_battle_fx.py
	@touch $@
$(SNES_FX_ASM) $(PROJ_DIR)/snes_battle_data.h: $(BUILD)/fx-assets.stamp
$(OBJ)/snes_battlefx.obj: $(BUILD)/fx-assets.stamp

obj-assets: $(SNES_OBJ_STAMP)

$(SNES_OBJ_STAMP): $(SNES_OBJ_INPUTS)
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_obj.py
	python3 tools/snes/gen_snes_bigcards.py
	@touch $@

$(SNES_OBJ_ASM): $(SNES_OBJ_STAMP)

$(SNES_SCENE_STAMP): $(SNES_SCENE_INPUTS)
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_scenes.py
	python3 tools/snes/gen_snes_dialogue.py
	@touch $@

$(SNES_SCENE_ASM): $(SNES_SCENE_STAMP)
$(patsubst $(PROJ_DIR)/assets/%.asm,$(OBJ)/%.obj,$(SNES_SCENE_ASM)): $(SNES_SCENE_STAMP)

$(SNES_AUDIO_ASSETS_OBJ): $(SNES_AUDIO_ASSETS_ASM) $(HDR) $(SNES_AUDIO_SNAPSHOTS)
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) -o $@ $<

.PRECIOUS: $(OBJ)/%.ps $(OBJ)/%.asm

# ── Link ─────────────────────────────────────────────────────────────────────
$(ROM): $(OBJS)
	@mkdir -p $(dir $@)
	@echo "[objects]" > $(OBJ)/linkfile
	@for o in $(OBJS); do echo "$(CURDIR)/$$o" >> $(OBJ)/linkfile; done
	@for o in $$(ls $(LIBDIR)); do echo "$(LIBDIR)/$$o" >> $(OBJ)/linkfile; done
	$(LD) -d -s -v -A -c -L $(LIBDIR) $(OBJ)/linkfile $@
	@$(MAKE) -s -f Makefile.snes banks

# The 4 MB ceiling is a build check, not a comment: a HiROM cartridge has no
# bank $100, so a section that spills past $FF is a corrupt ROM and not a
# bigger one.
banks:
	@sz=$$(stat -c %s $(ROM)); \
	 if [ "$$sz" -gt 4194304 ]; then \
	   echo "SNES: ROM is $$sz bytes, past the 4 MB HiROM ceiling"; exit 1; fi; \
	 mode=$$(od -An -tx1 -j 65493 -N1 $(ROM) | tr -d ' '); \
	 if [ "$$mode" != "31" ]; then \
	   echo "SNES: map mode byte is \$$$$mode, expected \$$31 (HiROM+FastROM)"; exit 1; fi; \
	 echo "SNES: $(ROM)  $$sz bytes, map mode \$$$$mode (HiROM + FastROM)"

# The harness needs the debug ROM's switches; the retail ROM is built too so
# a change that only compiles with SNES_DEBUG is caught here.
verify: rom
	$(MAKE) -f Makefile.snes DEBUG=1 rom
	python3 tools/snes/test_dialogue.py
	python3 tools/snes/verify.py

clean:
	rm -rf $(BUILD)

# Renderer tables and card sheets must be generated on a fresh checkout too.
$(PROJ_DIR)/snes_tables.asm: tools/snes/gen_snes_tables.py
	python3 $<
.PHONY: planar-assets
planar-assets: $(BUILD)/planar-assets.stamp
$(BUILD)/planar-assets.stamp: tools/snes/gen_snes_planar.py $(BUILD)/card-assets.stamp
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_planar.py
	@touch $@
$(SNES_PLANAR_ASM) $(PROJ_DIR)/snes_planar_data.h: $(BUILD)/planar-assets.stamp

$(BUILD)/card-assets.stamp: tools/snes/gen_snes_cards.py tools/snes/snes_dc.py $(SNES_OBJ_INPUTS)
	@mkdir -p $(dir $@)
	python3 tools/snes/gen_snes_cards.py
	@touch $@
$(PROJ_DIR)/assets/snes_cards.asm $(PROJ_DIR)/assets/snes_cards32.asm $(PROJ_DIR)/assets/snes_cards32b.asm $(PROJ_DIR)/snes_cards.h: $(BUILD)/card-assets.stamp
# INCBIN files are deliberately untracked: regenerating must also rebuild the
# corresponding objects, even when only a blob changed.
$(patsubst %.asm,$(OBJ)/%.obj,$(notdir $(SNES_PLANAR_ASM))): $(BUILD)/planar-assets.stamp
$(OBJ)/snes_cards.obj $(OBJ)/snes_cards32.obj $(OBJ)/snes_cards32b.obj: $(BUILD)/card-assets.stamp
