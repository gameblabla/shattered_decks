# Build output
build/
*.o
*.elf
*.map
*.lst
*.program.bin

# PC-FX / CD images, ROMs, BIOS
*.bin
*.cue
*.iso
*.chd
*.rom
pcfxbios.bin
pcfx.rom
pcfxga.rom

# Generated link header (regenerated by the cd target)
lbas.h

# Generated asset blobs (regenerated by tools/gen_*.py)
assets/generated/

# Save files / emulator state
*.sav

# Host build binaries
/waifu
/waifu_fm_headless
/waifu_sdl12

# Python caches
__pycache__/
*.pyc

# Local backups / scratch
*.before_*
*.fastboard_orig
*.cpython-*.pyc
crash.txt

# Bundled emulator source / reference (not part of the game)
pcfxemu/

# Vendored SDKs / toolchains / reference material (not part of the game)
/SDL3/
/SDL_gpu_examples/
/MegaPCM/
/PC-FX_Info/
/PCFX_ADPCM_example/
/liberis/
/megadev/
/pcfx_scsi_sigrok_protocol_decoder/
/sega-vr-disasm/
/x68000_playground/
/.vexp/
/FMTOWNSCD_EXAMPLE_Cube/

# FM TOWNS boot payload: gcc -E preprocessed assembly (regenerated from the
