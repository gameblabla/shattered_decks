# Source-only NEC PC-FX port build file.
# Requires a local V810/liberis toolchain; no binary toolchain is bundled here.

PREFIX ?= v810
V810GCC ?= /opt/v810-gcc
CC := $(PREFIX)-gcc
AS := $(PREFIX)-as
LD := $(PREFIX)-ld
OBJCOPY := $(PREFIX)-objcopy
PCFX_CDLINK ?= tools/pcfxtools/pcfx-cdlink
HOSTCC ?= gcc

PCFX_TARGET ?= waifupcfx
CDOUT ?= waifupcfx

# The game links libpcfx.  The canonical tree is the shared DoomPCFX checkout
# (the same one wolf-pcfx builds against): its eris/* headers carry the
# hardware-verified CD-DMA and CD-DA contracts that the stale in-tree copy
# predates.  The installed archive is $(V810GCC)/lib/libpcfx.a, built from that
# tree, and $(V810GCC)/include/pcfx matches it byte for byte -- so headers and
# archive stay in step.  $(LIBPCFX)/include comes FIRST so eris/* resolves there.
LIBPCFX ?= /home/anonymous/Documents/DEV/DoomPCFX/libpcfx
LIBPCFX_A := $(V810GCC)/lib/libpcfx.a
INCLUDES := \
  -I. -Isrc -Isrc/engine -Isrc/game -Isrc/generated -Isrc/platform/pcfx \
  -I$(LIBPCFX)/include -I$(V810GCC)/include -I$(V810GCC)/$(PREFIX)/include

CFLAGS ?= -O2 -fomit-frame-pointer -fno-builtin -ffunction-sections -fdata-sections -Werror=vla -Wall -Wextra -std=gnu99 -mv810 -mprolog-function -msda=0
# Render the moving 3D field live on PC-FX, cache only the resting views.
# WAIFU_BG_CACHE_DISABLE drops the per-camera board-background cache so the
# board renders straight from the small, hot floor sample LUT instead of a cold
# 61440-byte copy (that copy was the top data-side 2 KiB-DRAM-page sink after
# the int64-removal / DRAM-copy-batching perf work).  The battle-composite cache
# stays ENABLED but now caches only the two resting cameras (hand-idle and top
# view, see battle_base_cache_for_camera): those are the frames where the field
# is not moving, so scrolling the hand or reading the board is a cheap composite
# copy, while the hand<->top lift and any animating field render live full-time.
CFLAGS += -DWAIFU_BG_CACHE_DISABLE
PCFX_ASSET_MODE ?= cart
ifeq ($(PCFX_ASSET_MODE),cdrom)
CFLAGS += -DPLATFORM=1 -DWAIFU_FM_PCFX -DWAIFU_FM_NO_HEADLESS_MAIN -DWAIFU_ASSET_USE_CDROM -DWAIFU_ASSET_NO_STDIO $(INCLUDES)
ifeq ($(wildcard lbas.h),lbas.h)
CFLAGS += -DWAIFU_HAVE_GENERATED_LBAS
endif
ifeq ($(wildcard cdda_tracks.h),cdda_tracks.h)
CFLAGS += -DWAIFU_HAVE_CDDA_TRACKS
endif
else
CFLAGS += -DPLATFORM=1 -DWAIFU_FM_PCFX -DWAIFU_FM_NO_HEADLESS_MAIN -DWAIFU_ASSET_USE_CART_ROM -DWAIFU_ASSET_NO_STDIO $(INCLUDES)
endif
LDFLAGS ?= -L$(V810GCC)/lib -L$(V810GCC)/$(PREFIX)/lib -L$(V810GCC)/lib/gcc/$(PREFIX)/4.9.4 $(V810GCC)/$(PREFIX)/lib/crt0.o --gc-sections
# libpcfx.a is named by full path rather than -lpcfx so the archive that gets
# linked is unambiguously the installed one, whatever else is on the -L path.
LIBS ?= $(LIBPCFX_A) -lc -lsim -lnosys -lgcc

PCFX_SRCS_C := \
  src/platform/pcfx/pcfx_main.c \
  src/platform/pcfx/waifu_pcfx_video.c \
  src/platform/pcfx/waifu_pcfx_input.c \
  src/platform/pcfx/waifu_pcfx_audio.c \
  src/platform/pcfx/waifu_pcfx_cdrom.c \
  src/platform/pcfx/pcfx_biosfs.c \
  src/main.c \
  src/game/ai.c \
  src/game/deck.c \
  src/game/palette.c \
  src/game/sounds.c \
  src/game/assets.c \
  src/engine/renderer3d.c \
  src/engine/renderer3d_pcfx.c \
  src/engine/common.c
PCFX_SRCS_S := src/platform/pcfx/fastking.s src/platform/pcfx/pcfx_biosfs_asm.s

CARD_SOURCE_FILES := $(shell find assets/source/cards -type f 2>/dev/null | LC_ALL=C sort | sed 's/\\/\\\\/g; s/ /\\ /g')
STORY_PORTRAIT_FILES := $(shell find assets/source/story_portraits -type f 2>/dev/null | LC_ALL=C sort | sed 's/\\/\\\\/g; s/ /\\ /g')
SFX_SOURCE_FILES := $(shell find sounds assets/sounds -type f 2>/dev/null | LC_ALL=C sort | sed 's/\\/\\\\/g; s/ /\\ /g')
# Full-screen title/ending art is resolution-driven: gen_title_asset.py reads
# the build resolution from src/engine/cfx_screen_config.h and selects the
# matching per-resolution source PNG. Depend on the config + whatever source art
# exists so a resolution change (or art edit) retriggers regeneration.
TITLE_SOURCE_FILES := src/engine/cfx_screen_config.h $(wildcard assets/source/title/*.png assets/source/ending/*.png)
RAINBOW_SOURCE_FILES := assets/source/bg/desert.png assets/source/bg/stone.png assets/source/bg/ember.png assets/source/bg/sky.png

ASSET_GEN_FILES := \
  src/game/card_ids.h \
  src/generated/waifu_assets.h \
  src/generated/deck_pools.h \
  assets/generated/story_portraits.bin \
  assets/generated/story_portrait_mask.bin \
  assets/generated/card_faces.bin \
  assets/generated/card_big_art.bin \
  assets/generated/card_big_art_cd.bin \
  assets/generated/card_back.bin \
  assets/generated/support_face.bin \
  assets/generated/support_big_art.bin \
  assets/generated/support_big_art_cd.bin

PCFX_SFX_FILES := \
  src/generated/pcfx_sfx_adpcm.h \
  assets/generated/sfx_adpcm.bin

PCFX_PALETTE_FILES := \
  src/generated/pcfx_palette_assets.h

TITLE_ASSET_FILES := \
  src/generated/title_asset.h \
  assets/generated/title_screen_img.bin \
  assets/generated/title_screen_pcfx_img.bin \
  assets/generated/title_screen_pcfx_yuv16.bin \
  assets/generated/title_screen_pcfx_yuv422.bin \
  assets/generated/ending_screen_pcfx_yuv422.bin

CD_ASSETS := \
  assets/generated/title_screen_pcfx_img.bin \
  assets/generated/title_screen_pcfx_yuv422.bin \
  assets/generated/rainbow_desert.bin \
  assets/generated/rainbow_stone.bin \
  assets/generated/rainbow_ember.bin \
  assets/generated/rainbow_sky.bin \
  assets/generated/story_portraits.bin \
  assets/generated/story_portrait_mask.bin \
  assets/generated/card_faces.bin \
  assets/generated/card_big_art.bin \
  assets/generated/card_back.bin \
  assets/generated/support_face.bin \
  assets/generated/support_big_art.bin \
  assets/generated/sfx_adpcm.bin \
  assets/generated/ending_screen_pcfx_yuv422.bin

PCFX_RECOVERY_ASSETS := $(patsubst assets/generated/%,assets/generated/recovery/%,$(CD_ASSETS))
PCFX_CD_CHECKSUM_HEADER := src/generated/pcfx_cd_checksums.h

OBJDIR := build/pcfx
RAINBOW_BG_HEADER := src/generated/rainbow_bg_assets.h
RAINBOW_BG_STREAMS := \
  assets/generated/rainbow_desert.bin \
  assets/generated/rainbow_stone.bin \
  assets/generated/rainbow_ember.bin \
  assets/generated/rainbow_sky.bin
ELF_TARGET := $(OBJDIR)/$(PCFX_TARGET).elf
BIN_TARGET := $(OBJDIR)/$(PCFX_TARGET).program.bin
MAP_TARGET := $(OBJDIR)/$(PCFX_TARGET).map
# cdda.o used to be compiled here from the in-tree libpcfx/src/cdda.c; it now
# comes from $(LIBPCFX_A), which is where the CD-DA fixes live.
PCFX_OBJS := $(patsubst %.c,$(OBJDIR)/%.o,$(PCFX_SRCS_C)) $(patsubst %.s,$(OBJDIR)/%.o,$(PCFX_SRCS_S))

.PHONY: all program clean clean-build clean-output cd zip toolchain-check pcfxtools regression-pcfx-hand-card regression-pcfx-battle-card regression-pcfx-battle-card-stripe

all: cd

program: toolchain-check $(ELF_TARGET) $(BIN_TARGET)

toolchain-check:
	@command -v $(CC) >/dev/null || { echo "missing $(CC) (install V810/liberis toolchain and set V810GCC)"; exit 1; }
	@command -v $(AS) >/dev/null || { echo "missing $(AS)"; exit 1; }
	@command -v $(LD) >/dev/null || { echo "missing $(LD)"; exit 1; }
	@command -v $(OBJCOPY) >/dev/null || { echo "missing $(OBJCOPY)"; exit 1; }

$(PCFX_CDLINK): tools/pcfxtools/pcfx-cdlink.c tools/pcfxtools/boot.h
	$(MAKE) -C tools/pcfxtools CC=$(HOSTCC) pcfx-cdlink

pcfxtools: $(PCFX_CDLINK)

regression-pcfx-hand-card: cd
	./scripts/pcfx/hand_card_render_regression.sh $(CDOUT).cue

regression-pcfx-battle-card: cd
	./scripts/pcfx/battle_full_card_render_regression.sh $(CDOUT).cue

regression-pcfx-battle-card-stripe: cd
	./scripts/pcfx/battle_card_stripe_regression.sh $(CDOUT).cue

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(AS) $< -o $@

$(ASSET_GEN_FILES): tools/gen_assets.py $(CARD_SOURCE_FILES) $(STORY_PORTRAIT_FILES)
	@mkdir -p assets/generated src/generated
	python3 tools/gen_assets.py

$(PCFX_SFX_FILES): tools/gen_pcfx_sfx_adpcm.py $(SFX_SOURCE_FILES)
	@mkdir -p assets/generated src/generated
	python3 tools/gen_pcfx_sfx_adpcm.py

$(PCFX_PALETTE_FILES): tools/gen_pcfx_palette_assets.py src/generated/waifu_assets.h src/generated/title_asset.h
	@mkdir -p src/generated
	python3 tools/gen_pcfx_palette_assets.py

$(TITLE_ASSET_FILES): tools/gen_title_asset.py src/generated/waifu_assets.h $(TITLE_SOURCE_FILES)
	@mkdir -p assets/generated src/generated
	python3 tools/gen_title_asset.py

$(RAINBOW_BG_STREAMS) $(RAINBOW_BG_HEADER): tools/gen_pcfx_rainbow_bg.py $(RAINBOW_SOURCE_FILES)
	@mkdir -p assets/generated src/generated
	python3 tools/gen_pcfx_rainbow_bg.py --quality 95 --header $(RAINBOW_BG_HEADER) \
		assets/source/bg/desert.png assets/generated/rainbow_desert.bin WAIFU_PCFX_RAINBOW_DESERT \
		assets/source/bg/stone.png assets/generated/rainbow_stone.bin WAIFU_PCFX_RAINBOW_STONE \
		assets/source/bg/ember.png assets/generated/rainbow_ember.bin WAIFU_PCFX_RAINBOW_EMBER \
		assets/source/bg/sky.png assets/generated/rainbow_sky.bin WAIFU_PCFX_RAINBOW_SKY

$(PCFX_CD_CHECKSUM_HEADER) $(PCFX_RECOVERY_ASSETS): tools/gen_pcfx_cd_checksums.py $(CD_ASSETS)
	@mkdir -p assets/generated/recovery src/generated
	python3 tools/gen_pcfx_cd_checksums.py

$(OBJDIR)/src/platform/pcfx/waifu_pcfx_video.o: $(RAINBOW_BG_HEADER)
$(OBJDIR)/src/platform/pcfx/waifu_pcfx_video.o: $(PCFX_PALETTE_FILES)
$(OBJDIR)/src/platform/pcfx/waifu_pcfx_cdrom.o: $(RAINBOW_BG_HEADER)
$(OBJDIR)/src/platform/pcfx/waifu_pcfx_cdrom.o: $(PCFX_CD_CHECKSUM_HEADER)

$(ELF_TARGET): $(PCFX_OBJS)
	$(LD) $(LDFLAGS) $(PCFX_OBJS) $(LIBS) -o $@ -Map $(MAP_TARGET)

$(BIN_TARGET): $(ELF_TARGET)
	$(OBJCOPY) -O binary $< $@

$(OBJDIR)/cdlink.generated.txt: $(BIN_TARGET)
	@mkdir -p $(dir $@)
	@{ \
		echo "binary $(BIN_TARGET)"; \
		echo "lbaheader lbas.h"; \
		echo "cddaheader cdda_tracks.h"; \
		echo "track1audio TRACK1.wav"; \
		echo "name Waifu FM"; \
		echo "maker ChatGPT"; \
		echo "country JP"; \
		echo "version 01"; \
		echo "date 20260619"; \
		for f in $(CD_ASSETS) $(PCFX_RECOVERY_ASSETS); do echo "append $$f"; done; \
	} > $@

clean-output:
	rm -f $(CDOUT).cue $(CDOUT).bin $(CDOUT)_t*.bin waifupcfx_pyramid.cue lbas.h cdda_tracks.h

cd: clean-output toolchain-check $(PCFX_CDLINK) $(ASSET_GEN_FILES) $(PCFX_SFX_FILES) $(TITLE_ASSET_FILES) $(PCFX_PALETTE_FILES) $(CD_ASSETS) $(PCFX_CD_CHECKSUM_HEADER) $(PCFX_RECOVERY_ASSETS)
	# Pass 1: build without lbas.h/cdda_tracks.h, run cdlink to generate both headers
	#         and convert WAV tracks to raw CD-audio bins.
	$(MAKE) -f Makefile.pcfx clean-build PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX) PCFX_CDLINK=$(PCFX_CDLINK) HOSTCC=$(HOSTCC)
	$(MAKE) -f Makefile.pcfx program PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX)
	$(MAKE) -f Makefile.pcfx $(OBJDIR)/cdlink.generated.txt PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX)
	$(PCFX_CDLINK) $(OBJDIR)/cdlink.generated.txt $(CDOUT)
	# Pass 2: rebuild with lbas.h + cdda_tracks.h so LBA/CDDA constants are baked in.
	#         pcfx-cdlink skips WAV reconversion (bins are newer than source WAVs).
	$(MAKE) -f Makefile.pcfx clean-build PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX) PCFX_CDLINK=$(PCFX_CDLINK) HOSTCC=$(HOSTCC)
	$(MAKE) -f Makefile.pcfx program PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX)
	$(MAKE) -f Makefile.pcfx $(OBJDIR)/cdlink.generated.txt PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX)
	$(PCFX_CDLINK) $(OBJDIR)/cdlink.generated.txt $(CDOUT)
	# Pass 3: rebuild once more with the pass-2 LBA table.  Enabling generated
	#         LBA/CDDA constants can change the boot binary by a sector; the
	#         final image must use the same LBA table that was baked into it.
	$(MAKE) -f Makefile.pcfx clean-build PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX) PCFX_CDLINK=$(PCFX_CDLINK) HOSTCC=$(HOSTCC)
	$(MAKE) -f Makefile.pcfx program PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX)
	$(MAKE) -f Makefile.pcfx $(OBJDIR)/cdlink.generated.txt PCFX_TARGET=$(PCFX_TARGET) PCFX_ASSET_MODE=cdrom V810GCC=$(V810GCC) PREFIX=$(PREFIX)
	$(PCFX_CDLINK) $(OBJDIR)/cdlink.generated.txt $(CDOUT)
	# Compatibility cue name for existing pyramid-save SRAM files.  Some PC-FX
	# frontends key BackupRAM sidecars from the .cue basename; a save named
	# waifupcfx_pyramid.cue.srm will now load without renaming the binary track.
	cp $(CDOUT).cue waifupcfx_pyramid.cue

clean-build:
	rm -rf $(OBJDIR) out.bin

# Package the runnable CD image (data track + cue + CDDA audio tracks) into a
# single distributable zip.  Builds the image first so the package is fresh.
ZIP_NAME ?= ShatteredDecks_PCFX_gbb_2026.zip

zip: cd
	@command -v zip >/dev/null || { echo "missing 'zip' tool"; exit 1; }
	rm -f $(ZIP_NAME)
	# _*.bin globs both the audio lead track ($(CDOUT)_t01.bin) and every
	# stem-keyed CD-DA music track ($(CDOUT)_<Song>.bin); $(CDOUT).bin (the
	# data track, no underscore suffix) is listed explicitly above.
	zip -j $(ZIP_NAME) $(CDOUT).cue $(CDOUT).bin $(CDOUT)_*.bin
	@echo "Packaged $(ZIP_NAME)"

clean:
	# _*.bin also removes the stem-keyed CD-DA music cache (kept across builds
	# for fast reripping); a full clean resets it too.
	rm -rf $(OBJDIR) $(CDOUT).cue $(CDOUT).bin $(CDOUT)_*.bin waifupcfx_pyramid.cue out.bin lbas.h cdda_tracks.h $(ZIP_NAME)
