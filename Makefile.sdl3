# Shattered Decks — PC (desktop) build file.
#
# Builds the SDL3 release frontend: the SDL_GPU renderer (true-colour 3D board,
# full-resolution card art, FreeType text) plus the release shell (persisted
# settings, action-based keyboard/gamepad input, pause + options menu) around
# the same platform-agnostic game core every console target runs.
#
#   make -f Makefile.sdl3            # build ./shattered_decks
#   make -f Makefile.sdl3 run        # build and play
#   make -f Makefile.sdl3 debug      # -O0 -g build with sanitizers off
#   make -f Makefile.sdl3 shaders    # regenerate the embedded SPIR-V header
#   make -f Makefile.sdl3 card-paths # regenerate the hi-res source path table
#   make -f Makefile.sdl3 static    # self-contained binary (SDL3 + FFmpeg built in)
#   make -f Makefile.sdl3 clean
#
# Dependencies (pkg-config): sdl3, libpng, libwebp, freetype2, zlib, and the
# FFmpeg libraries (libavformat/libavcodec/libavutil/libswscale) behind the
# animated title screen. FFmpeg is optional: without it (FFMPEG=0, or no
# pkg-config entry) the title falls back to the still 16:9 photograph.
#
# `make -f Makefile.sdl3 static` instead builds SDL3 and FFmpeg once from the
# tarballs in this directory into build/deps/prefix and links them into the
# executable, so the result runs on a machine with neither installed. The
# dependency build is stamped: later `static` builds reuse it and only relink.
# glslc (shaderc) is needed ONLY by the `shaders` target — the generated header
# is checked in, so a plain build needs no shader tools.

CC ?= gcc
PKG_CONFIG ?= pkg-config
RM = rm -rf

# The shipped executable name. Overridable for packaging:
#   make -f Makefile.sdl3 SDL3_TARGET=shattered-decks-linux-x86_64
SDL3_TARGET ?= shattered_decks

OBJDIR := build/sdl3

# ---- dependencies ----------------------------------------------------------

SDL3_CFLAGS ?= $(shell $(PKG_CONFIG) --cflags sdl3 2>/dev/null)
SDL3_LIBS ?= $(shell $(PKG_CONFIG) --libs sdl3 2>/dev/null)
# Full-resolution card / title / ending art decodes the source PNG/WebP.
SDL3_IMG_CFLAGS ?= $(shell $(PKG_CONFIG) --cflags libpng libwebp 2>/dev/null)
SDL3_IMG_LIBS ?= $(shell $(PKG_CONFIG) --libs libpng libwebp 2>/dev/null)
# High-resolution TTF text.
SDL3_FT_CFLAGS ?= $(shell $(PKG_CONFIG) --cflags freetype2 2>/dev/null)
SDL3_FT_LIBS ?= $(shell $(PKG_CONFIG) --libs freetype2 2>/dev/null)

# The looping animated title screen (software decode + NVDEC when present).
# FFMPEG=0 drops it and keeps the still title.
FFMPEG ?= $(if $(shell $(PKG_CONFIG) --exists libavformat && echo y),1,0)
FFMPEG_PKGS := libavformat libavcodec libavutil libswscale
ifeq ($(FFMPEG),1)
SDL3_AV_CFLAGS ?= $(shell $(PKG_CONFIG) --cflags $(FFMPEG_PKGS) 2>/dev/null) -DWAIFU_SDL3_FFMPEG=1
SDL3_AV_LIBS ?= $(shell $(PKG_CONFIG) --libs $(FFMPEG_PKGS) 2>/dev/null)
else
SDL3_AV_CFLAGS ?=
SDL3_AV_LIBS ?=
endif

# ---- flags -----------------------------------------------------------------

INCLUDES := -Isrc/engine -Isrc/generated -Isrc/record -Isrc/game -Isrc/platform/sdl3

# WAIFU_PLATFORM_HW3D routes every 2D/3D primitive through the capture seams
# (src/engine/hw3d.h) instead of the software rasterizer. The CPU pixel caches
# cache software-rendered framebuffer content that never exists here, so they
# are compiled out to keep the capture stream complete every frame.
DEFINES := -DPLATFORM=5 -DBY16=1 -DHARDWARE_DIV=1 \
  -DWAIFU_FM_NO_HEADLESS_MAIN -DWAIFU_PLATFORM_HW3D=1 \
  -DWAIFU_BG_CACHE_DISABLE -DWAIFU_BATTLE_BASE_CACHE_DISABLE

WARNINGS ?= -Wall -Wextra -Wno-unused-parameter
OPT ?= -O2

CFLAGS ?= $(OPT) -std=c99 $(WARNINGS)
ALL_CFLAGS := $(CFLAGS) $(DEFINES) $(INCLUDES) \
  $(SDL3_CFLAGS) $(SDL3_IMG_CFLAGS) $(SDL3_FT_CFLAGS) $(SDL3_AV_CFLAGS) $(EXTRA_CFLAGS)

LDFLAGS ?=
LIBS := $(SDL3_LIBS) $(SDL3_IMG_LIBS) $(SDL3_FT_LIBS) $(SDL3_AV_LIBS) -lm -lz

# ---- sources ---------------------------------------------------------------

# The PC frontend: renderer + release shell.
SDL3_PLATFORM_SRCS := \
  src/platform/sdl3/sdl3_main.c \
  src/platform/sdl3/sdl3_video.c \
  src/platform/sdl3/sdl3_audio.c \
  src/platform/sdl3/sdl3_scene3d.c \
  src/platform/sdl3/sdl3_image_load.c \
  src/platform/sdl3/sdl3_hires.c \
  src/platform/sdl3/sdl3_text.c \
  src/platform/sdl3/sdl3_settings.c \
  src/platform/sdl3/sdl3_input.c \
  src/platform/sdl3/sdl3_overlay.c \
  src/platform/sdl3/sdl3_menu.c \
  src/platform/sdl3/sdl3_mouse.c \
  src/platform/sdl3/sdl3_fire.c \
  src/platform/sdl3/sdl3_video_ffmpeg.c

# The shared game core and engine, identical to every console target.
SDL3_CORE_SRCS := \
  src/main.c \
  src/game/ai.c \
  src/game/deck.c \
  src/game/palette.c \
  src/game/sounds.c \
  src/game/assets.c \
  src/engine/renderer3d.c \
  src/engine/renderer3d_generic.c \
  src/engine/common.c \
  src/engine/bmp_writer.c \
  src/platform/host_storage.c \
  src/platform/host_assets.c

SDL3_SRCS := $(SDL3_PLATFORM_SRCS) $(SDL3_CORE_SRCS)
SDL3_OBJS := $(patsubst %.c,$(OBJDIR)/%.o,$(SDL3_SRCS))
SDL3_DEPS := $(SDL3_OBJS:.o=.d)

# Generated headers the build consumes (all checked in).
GENERATED := \
  src/generated/sdl3_shaders.h \
  src/generated/sdl3_card_paths.h \
  src/generated/waifu_assets.h \
  src/generated/deck_pools.h \
  src/generated/title_asset.h \
  src/generated/sound_assets.h

# ---- rules -----------------------------------------------------------------

.PHONY: all run debug shaders card-paths assets toolchain-check clean clean-build \
  static deps deps-sdl3 deps-ffmpeg distclean-deps

all: $(SDL3_TARGET)

$(SDL3_TARGET): $(SDL3_OBJS)
	$(CC) $(LDFLAGS) $(SDL3_OBJS) $(LIBS) -o $@

$(OBJDIR)/%.o: %.c $(GENERATED)
	@mkdir -p $(dir $@)
	$(CC) $(ALL_CFLAGS) -MMD -MP -c $< -o $@

run: $(SDL3_TARGET)
	./$(SDL3_TARGET)

# Unoptimized build with symbols, in its own object tree so it never collides
# with the release objects.
debug:
	$(MAKE) -f Makefile.sdl3 OPT="-O0 -g3 -fno-omit-frame-pointer" \
	  OBJDIR=build/sdl3-debug SDL3_TARGET=$(SDL3_TARGET)-debug

# Regenerates src/generated/sdl3_shaders.h from src/platform/sdl3/shaders/.
# Needs glslc; the header is checked in, so a plain build never runs this.
shaders:
	python3 tools/gen_sdl3_shaders.py

# Regenerates the card_id -> source-art path table used by the hi-res loader.
card-paths:
	python3 tools/gen_sdl3_hires_paths.py

# Full asset regeneration (shared with the console targets).
assets:
	$(MAKE) assets

# ---- self-contained (static) build -------------------------------------------
#
# Builds SDL3 and FFmpeg from the tarballs beside this makefile into
# $(DEPS_PREFIX) and links the game against those .a files, so the shipped
# executable needs neither installed. Both are stamped: once a dependency is
# built, `static` reuses it and never unpacks or configures again (delete the
# stamp, or run `distclean-deps`, to force a rebuild).
#
# libpng / libwebp / freetype / zlib still come from the system; they are
# ubiquitous, and pulling them in too would mean building four more trees.

DEPS_DIR := build/deps
DEPS_PREFIX := $(abspath $(DEPS_DIR)/prefix)
DEPS_PKGCONFIG := $(DEPS_PREFIX)/lib/pkgconfig:$(DEPS_PREFIX)/lib64/pkgconfig

SDL3_TARBALL ?= $(wildcard SDL3-*.tar.gz)
FFMPEG_TARBALL ?= $(wildcard ffmpeg-*.tar.xz)

SDL3_STAMP := $(DEPS_DIR)/.sdl3-built
FFMPEG_STAMP := $(DEPS_DIR)/.ffmpeg-built

# FFmpeg, cut down to what the title clip needs: H.264/HEVC in MP4/MOV, plus
# the NVDEC (CUDA) hardware path, which builds against a stub header set and
# dlopen()s the driver at run time -- so this needs no CUDA toolkit installed
# and still hardware-decodes on a machine that has an NVIDIA driver.
FFMPEG_CONFIGURE_FLAGS ?= \
  --disable-shared --enable-static --enable-pic \
  --disable-programs --disable-doc --disable-avdevice --disable-avfilter \
  --disable-network --disable-encoders --disable-muxers \
  --disable-bsfs --disable-devices --disable-filters \
  --disable-everything \
  --enable-decoder=h264 --enable-decoder=hevc --enable-decoder=mpeg4 \
  --enable-decoder=vp9 --enable-decoder=h264_cuvid --enable-decoder=hevc_cuvid \
  --enable-parser=h264 --enable-parser=hevc --enable-parser=mpeg4video \
  --enable-parser=vp9 \
  --enable-demuxer=mov --enable-demuxer=matroska \
  --enable-protocol=file --enable-swscale \
  --enable-ffnvcodec --enable-cuvid --enable-nvdec

deps-sdl3: $(SDL3_STAMP)
deps-ffmpeg: $(FFMPEG_STAMP)
deps: deps-sdl3 deps-ffmpeg

$(SDL3_STAMP):
	@test -n "$(SDL3_TARBALL)" || { echo "no SDL3-*.tar.gz here"; exit 1; }
	@mkdir -p $(DEPS_DIR)/src
	tar -xf $(SDL3_TARBALL) -C $(DEPS_DIR)/src
	cmake -S $(DEPS_DIR)/src/$(basename $(basename $(SDL3_TARBALL))) \
	  -B $(DEPS_DIR)/build-sdl3 -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_INSTALL_PREFIX=$(DEPS_PREFIX) -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
	  -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF
	cmake --build $(DEPS_DIR)/build-sdl3 -j$(shell nproc)
	cmake --install $(DEPS_DIR)/build-sdl3
	@touch $@

# nv-codec-headers: the NVDEC stubs FFmpeg configures against. Cloned only if
# absent, so a built dependency tree never touches the network again.
$(DEPS_PREFIX)/include/ffnvcodec/nvEncodeAPI.h:
	@mkdir -p $(DEPS_DIR)/src
	@test -d $(DEPS_DIR)/src/nv-codec-headers || \
	  git clone --depth 1 https://github.com/FFmpeg/nv-codec-headers.git \
	    $(DEPS_DIR)/src/nv-codec-headers
	$(MAKE) -C $(DEPS_DIR)/src/nv-codec-headers PREFIX=$(DEPS_PREFIX) install

$(FFMPEG_STAMP): $(DEPS_PREFIX)/include/ffnvcodec/nvEncodeAPI.h
	@test -n "$(FFMPEG_TARBALL)" || { echo "no ffmpeg-*.tar.xz here"; exit 1; }
	@mkdir -p $(DEPS_DIR)/src
	tar -xf $(FFMPEG_TARBALL) -C $(DEPS_DIR)/src
	cd $(DEPS_DIR)/src/$(basename $(basename $(FFMPEG_TARBALL))) && \
	  PKG_CONFIG_PATH=$(DEPS_PKGCONFIG) ./configure --prefix=$(DEPS_PREFIX) \
	    $(FFMPEG_CONFIGURE_FLAGS) && \
	  $(MAKE) -j$(shell nproc) && $(MAKE) install
	@touch $@

# The static link. --static on pkg-config pulls each library's own transitive
# dependencies (dl, pthread, X11/Wayland, ...) in as system shared libraries;
# only SDL3 and FFmpeg are baked in.
static: deps
	$(MAKE) -f Makefile.sdl3 OBJDIR=build/sdl3-static \
	  SDL3_TARGET=$(SDL3_TARGET) \
	  PKG_CONFIG="env PKG_CONFIG_PATH=$(DEPS_PKGCONFIG) $(PKG_CONFIG) --static" \
	  FFMPEG=1

distclean-deps:
	$(RM) $(DEPS_DIR)

# Reports whether every library this build needs is installed.
toolchain-check:
	@ok=1; \
	for p in sdl3 libpng libwebp freetype2 zlib; do \
	  if $(PKG_CONFIG) --exists $$p; then \
	    echo "  ok      $$p $$($(PKG_CONFIG) --modversion $$p)"; \
	  else \
	    echo "  MISSING $$p"; ok=0; \
	  fi; \
	done; \
	if $(PKG_CONFIG) --exists $(FFMPEG_PKGS); then \
	  echo "  ok      ffmpeg $$($(PKG_CONFIG) --modversion libavcodec) (animated title)"; \
	else \
	  echo "  absent  ffmpeg (animated title falls back to the still image)"; \
	fi; \
	command -v glslc >/dev/null 2>&1 \
	  && echo "  ok      glslc (only needed by 'make -f Makefile.sdl3 shaders')" \
	  || echo "  absent  glslc (only needed by 'make -f Makefile.sdl3 shaders')"; \
	test $$ok -eq 1 || { echo "install the missing packages and re-run"; exit 1; }

clean-build:
	$(RM) $(OBJDIR) build/sdl3-debug

clean: clean-build
	$(RM) $(SDL3_TARGET) $(SDL3_TARGET)-debug

-include $(SDL3_DEPS)
