  openmsx disasm <rom.bin> [output.asm [coverage.cov]]
  openmsx reasm <input.asm> [output.bin|output-dir/]
  openmsx cov <rom.bin> <coverage.cov> [frames] [--bios bios.rom] [--direct-cart]
  openmsx snap <rom.bin> [frames] [--bios bios.rom] [--direct-cart]
