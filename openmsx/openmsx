#!/usr/bin/env python3
"""Project command layer for the supplied openMSX headless build.

The archive contains a useful deterministic headless binary whose command set
predates scripted input.  This front end adds the workflow commands and builds
an input-enabled cache copy of that exact backend.  Existing headless commands
are passed through unchanged.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import zipfile
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Optional

from patch_backend import BackendPatchError, ensure_input_backend


VERSION = "openMSX project command layer 1.1-input"
FRAME_RATE = 60


class CliError(Exception):
    pass


@dataclass(frozen=True)
class Event:
    frame: int
    operation: str
    token: str
    line: int


@dataclass(frozen=True)
class InputSchedule:
    events: tuple[Event, ...]
    source: Path

    @property
    def last_frame(self) -> int:
        return max((event.frame for event in self.events), default=0)


# MSX keyboard matrix positions from openMSX's own Keyboard.cc.  The low
# three bits are the column; the value is the bit mask accepted by
# keymatrixdown/keymatrixup.
MSX_MATRIX = {
    **{str(i): (0, 1 << i) for i in range(8)},
    **{str(i): (1, 1 << (i - 8)) for i in range(8, 16)},
    "QUOTE": (2, 0x01), "APOSTROPHE": (2, 0x01), "GRAVE": (2, 0x02),
    "BACKQUOTE": (2, 0x02), "COMMA": (2, 0x04), "PERIOD": (2, 0x08),
    "SLASH": (2, 0x10), "ACC": (2, 0x20), "A": (2, 0x40),
    "B": (2, 0x80),
    "C": (3, 0x01), "D": (3, 0x02), "E": (3, 0x04), "F": (3, 0x08),
    "G": (3, 0x10), "H": (3, 0x20), "I": (3, 0x40), "J": (3, 0x80),
    "K": (4, 0x01), "L": (4, 0x02), "M": (4, 0x04), "N": (4, 0x08),
    "O": (4, 0x10), "P": (4, 0x20), "Q": (4, 0x40), "R": (4, 0x80),
    "S": (5, 0x01), "T": (5, 0x02), "U": (5, 0x04), "V": (5, 0x08),
    "W": (5, 0x10), "X": (5, 0x20), "Y": (5, 0x40), "Z": (5, 0x80),
    "SHIFT": (6, 0x01), "CTRL": (6, 0x02), "GRAPH": (6, 0x04),
    "CAPS": (6, 0x08), "CODE": (6, 0x10), "F1": (6, 0x20),
    "F2": (6, 0x40), "F3": (6, 0x80), "F4": (7, 0x01),
    "F5": (7, 0x02), "ESC": (7, 0x04), "TAB": (7, 0x08),
    "STOP": (7, 0x10), "BACKSPACE": (7, 0x20), "BS": (7, 0x20),
    "SELECT": (7, 0x40), "RETURN": (7, 0x80), "ENTER": (7, 0x80),
    "SPACE": (8, 0x01), "HOME": (8, 0x02), "INSERT": (8, 0x04),
    "DELETE": (8, 0x08), "LEFT": (8, 0x10), "UP": (8, 0x20),
    "DOWN": (8, 0x40), "RIGHT": (8, 0x80),
}

# The project's MSX2 input contract uses space/escape for the two action
# buttons.  This also makes BlastEm's P/A/B vocabulary useful on MSX.
TOKEN_ALIASES = {
    "P": "A", "START": "A", "FIRE": "A", "BUTTON1": "A",
    "TRIGGER": "A", "BUTTONA": "A", "BUTTON2": "B", "TRIGGERB": "B",
    "BUTTONB": "B", "SELECT": "SELECT", "MODE": "SELECT",
    "ESCAPE": "ESC", "RETURN": "RETURN", "ENTER": "RETURN",
}

JOYSTICK_BITS = {
    "UP": 0x01, "DOWN": 0x02, "LEFT": 0x04, "RIGHT": 0x08,
    "A": 0x10, "B": 0x20,
}


