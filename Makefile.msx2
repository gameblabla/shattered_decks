# ─────────────────────────────────────────────────────────────────────────────
#  Makefile.msx2 — MSX2 / NEO-16 cartridge target
#
#  Wraps MSXgl's node build.  MSXGL_PATH points at the engine tree (vendored,
#  not committed), so nothing here depends on where the SDK happens to live.
#
#      make -f Makefile.msx2                 # regenerate tables, build the ROM
#      make -f Makefile.msx2 verify          # build, then run it headless
#      make -f Makefile.msx2 ROM_SIZE_KB=16384
#
#  See MSX2_PORT_PLAN.md, and src/msx2/STATUS.md for where the port stands.
# ─────────────────────────────────────────────────────────────────────────────

MSXGL_PATH   ?= MSXgl-main
PROJ_DIR     := src/msx2
BUILD_JS     := $(abspath $(MSXGL_PATH))/engine/script/js/build.js
OUT_DIR      := $(PROJ_DIR)/out
ROM          := $(OUT_DIR)/waifu_msx2.rom
MAP          := $(OUT_DIR)/waifu_msx2.map

# NEO-16 spans 1 MB to 64 MB.  Bring-up uses the smallest legal size so the
# build-and-verify loop stays fast; the shipping cartridge is 16384.
ROM_SIZE_KB  ?= 1024

# Headless verification (see msx2.sh for the full flow).
OPENMSX      := $(MSXGL_PATH)/openmsx-headless-21.0-capture-neo1.2-planarfix-linux-x86_64/openmsx
MSX2_BIOS    := $(MSXGL_PATH)/msx2.rom
FRAMES       ?= 600

GENERATED    := src/generated/msx2_card_tables.h src/generated/msx2_scenes.h
SCENE_BINS   := $(PROJ_DIR)/assets/title.bin $(PROJ_DIR)/assets/ending.bin
SCENE_SRC    := assets/source/title/title256_msx2.png \
                assets/source/ending/ending256x212.png

SOURCES := $(wildcard $(PROJ_DIR)/*.c) $(wildcard $(PROJ_DIR)/*.h) \
           $(wildcard $(PROJ_DIR)/*.s) $(PROJ_DIR)/project_config.js \
           $(PROJ_DIR)/msxgl_config.h \
           src/game/deck.c src/game/ai.c

.PHONY: all rom tables verify soak clean check-sdk

all: rom

check-sdk:
	@test -f "$(BUILD_JS)" || { \
	  echo "MSXgl not found at $(MSXGL_PATH). Set MSXGL_PATH=/path/to/MSXgl."; \
	  exit 1; }

# The generated card tables are lifted out of the shared asset header; the
# regenerate-or-desync trap that bites the other targets is closed by making
# every build depend on them.
tables: $(GENERATED)

src/generated/msx2_card_tables.h: tools/msx2/gen_msx_tables.py src/generated/waifu_assets.h
	python3 tools/msx2/gen_msx_tables.py

# The scene binaries and the header naming their segments are one output:
# regenerating either alone would desync the ROM from the streamer.
src/generated/msx2_scenes.h $(SCENE_BINS) &: tools/msx2/gen_msx_scenes.py $(SCENE_SRC)
	python3 tools/msx2/gen_msx_scenes.py

rom: $(ROM)

$(ROM): $(SOURCES) $(GENERATED) $(SCENE_BINS) tools/msx2/pack_msx_rom.py | check-sdk
	cd $(PROJ_DIR) && MSX2_ROM_SIZE_KB=$(ROM_SIZE_KB) MSX2_AUTOPLAY=$(MSX2_AUTOPLAY) \
	    node $(BUILD_JS)
	python3 tools/msx2/pack_msx_rom.py $(ROM)
	@ls -l $(ROM)

verify: rom
	./msx2.sh verify --frames $(FRAMES)

# The soak ROM.  Identical to the shipping one except that the player's turn is
# played by the AI, so a headless run finishes whole duels with no input --
# which is the only way the M1a evidence survives now that the duel is a screen
# a human drives.  The object tree is dropped first because MSXgl's incremental
# compile does not know about a changed -D.
soak:
	rm -rf $(OUT_DIR)
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) rom MSX2_AUTOPLAY=1

clean:
	rm -rf $(OUT_DIR) $(PROJ_DIR)/emul $(PROJ_DIR)/lib
