# ─────────────────────────────────────────────────────────────────────────────
#  Makefile.msx2 — MSX2 / NEO-16 cartridge target
#
#  Wraps MSXgl's node build.  MSXGL_PATH points at the engine tree (vendored,
#  not committed), so nothing here depends on where the SDK happens to live.
#
#      make -f Makefile.msx2                 # regenerate tables, build the ROM
#      make -f Makefile.msx2 verify          # build, then run it headless
#      make -f Makefile.msx2 ROM_SIZE_KB=16384
#
#  See MSX2_PORT_PLAN.md, and src/msx2/STATUS.md for where the port stands.
# ─────────────────────────────────────────────────────────────────────────────

.DEFAULT_GOAL := all

MSXGL_PATH   ?= MSXgl-main
PROJ_DIR     := src/msx2
BUILD_JS     := $(abspath $(MSXGL_PATH))/engine/script/js/build.js
OUT_DIR      := $(PROJ_DIR)/out
ROM          := $(OUT_DIR)/waifu_msx2.rom
MAP          := $(OUT_DIR)/waifu_msx2.map
AUTOPLAY_TAG := $(if $(MSX2_PLUS),plus,$(if $(MSX2_REGRESSION),regression,$(if $(MSX2_STORY_AUTOPLAY),story-soak,$(if $(MSX2_AUTOPLAY),soak,shipping))))
VARIANT_STAMP := $(OUT_DIR)/.variant-$(AUTOPLAY_TAG)

# NEO-16 spans 1 MB to 64 MB in powers of two.  The cartridge is the smallest
# of those the baked assets fit in: the last asset segment is 244, so the image
# has to reach 3,920 KB and 4,096 is the next boundary up.  This is both the
# bring-up and the shipping size -- there is nothing to gain from a larger one,
# and pack_msx_rom.py prints the headroom and fails the build if a segment ever
# runs off the end.
#
# The next boundary DOWN, 2 MB, is not reachable by packing alone.  The assets
# hold 2,558 KB of real bytes inside their 3,792 KB of segment-aligned strides,
# so even a perfectly packed cartridge would need about 2,654 KB with the code;
# 2 MB needs either compression or fewer assets, not tighter placement.
ROM_SIZE_KB  ?= 4096

# Headless verification (see msx2.sh for the full flow).
OPENMSX      := $(MSXGL_PATH)/openmsx-headless-21.0-capture-neo1.2-planarfix-linux-x86_64/openmsx
MSX2_BIOS    := $(MSXGL_PATH)/msx2.rom
FRAMES       ?= 600

GENERATED    := src/generated/msx2_card_tables.h src/generated/msx2_scenes.h
# One lVGM stream per (sound chip, track).  The FM sets have no title theme;
# msx2_audio.c plays the PSG recording for a track its chip's set is missing,
# so only the PSG set is required to be complete.
MUSIC_TRACKS := title overworld battle boss final_boss result lost
MUSIC_BINS   := $(addprefix $(PROJ_DIR)/assets/music_,$(addsuffix .bin,$(MUSIC_TRACKS)))
AUDIO_META   := $(PROJ_DIR)/assets/music.json
# Two of the three source directories have a space in their name ("MSX OPLL"),
# and $(wildcard) has no way to say so.  find + sed escapes them the one way a
# prerequisite list understands.
AUDIO_SRC    := $(shell find msx_music -name '*.vgm' | sed 's/ /\\ /g')
VGM_TOOL_SRC := FMTOWNSCD_EXAMPLE_Cube/vgmtools/CMakeLists.txt \
                FMTOWNSCD_EXAMPLE_Cube/vgmtools/vgm_cmp.c
SCENE_BINS   := $(PROJ_DIR)/assets/title.bin $(PROJ_DIR)/assets/ending.bin \
                $(PROJ_DIR)/assets/board_mesh.bin
SCENE_SRC    := assets/source/title/title256_msx2.png \
                assets/source/ending/ending256x212.png

FLOOR_OUTPUTS := $(PROJ_DIR)/msx2_floor_data.h $(PROJ_DIR)/assets/floor_textures.bin \
                 $(PROJ_DIR)/assets/floor_spans.bin $(PROJ_DIR)/assets/floor_manifest.txt

$(FLOOR_OUTPUTS) &: tools/msx2/gen_msx_floor.py tools/msx2/msx2_grb332.py \
        $(SCENE_BINS) src/generated/msx2_scenes.h \
        assets/source/textures/sandstone_1.png assets/source/textures/sandstone_2.png
	python3 tools/msx2/gen_msx_floor.py

SOURCES := $(wildcard $(PROJ_DIR)/*.c) $(wildcard $(PROJ_DIR)/*.h) \
           $(wildcard $(PROJ_DIR)/*.s) $(PROJ_DIR)/project_config.js \
           $(PROJ_DIR)/msxgl_config.h \
           src/game/deck.c src/game/ai.c

.PHONY: all rom tables audio verify soak story-soak regression plus plus-assets clean check-sdk

all: rom

check-sdk:
	@test -f "$(BUILD_JS)" || { \
	  echo "MSXgl not found at $(MSXGL_PATH). Set MSXGL_PATH=/path/to/MSXgl."; \
	  exit 1; }

# The generated card tables are lifted out of the shared asset header; the
# regenerate-or-desync trap that bites the other targets is closed by making
# every build depend on them.
tables: $(GENERATED)

audio: $(AUDIO_META) $(MUSIC_BINS)

$(AUDIO_META) $(MUSIC_BINS) &: tools/msx2/gen_msx_audio.py $(AUDIO_SRC) $(VGM_TOOL_SRC)
	python3 tools/msx2/gen_msx_audio.py

src/generated/msx2_card_tables.h: tools/msx2/gen_msx_tables.py src/generated/waifu_assets.h
	python3 tools/msx2/gen_msx_tables.py

# The scene binaries and the header naming their segments are one output:
# regenerating either alone would desync the ROM from the streamer.
# The board is captured out of the shared renderer, so src/main.c is one of the
# inputs: a change to the arena, the card geometry or the MSX2 camera pose has
# to re-bake the cartridge or the two disagree about where a card goes.
src/generated/msx2_scenes.h $(SCENE_BINS) &: tools/msx2/gen_msx_scenes.py \
        $(PROJ_DIR)/msx2_ui_strings.def \
        tools/msx2/gen_msx_views.py src/main.c $(SCENE_SRC) \
        $(AUDIO_META) $(MUSIC_BINS)
	python3 tools/msx2/gen_msx_scenes.py

rom: $(ROM)

# MSXgl's incremental builder does not track changed -D flags.  Keep the build
# variant in the dependency graph so a plain shipping build after `make soak`
# cannot silently reuse the autoplay cartridge (and vice versa).
$(VARIANT_STAMP):
	@mkdir -p $(OUT_DIR)
	@rm -f $(OUT_DIR)/.variant-*
	@touch $@

$(ROM): $(FLOOR_OUTPUTS) $(SOURCES) $(GENERATED) $(SCENE_BINS) $(MUSIC_BINS) $(AUDIO_META) \
        tools/msx2/pack_msx_rom.py $(VARIANT_STAMP) | check-sdk
	cd $(PROJ_DIR) && MSX2_ROM_SIZE_KB=$(ROM_SIZE_KB) MSX2_AUTOPLAY=$(MSX2_AUTOPLAY) \
	    MSX2_STORY_AUTOPLAY=$(MSX2_STORY_AUTOPLAY) MSX2_REGRESSION=$(MSX2_REGRESSION) \
	    MSX2_PLUS=$(MSX2_PLUS) \
	    MSX2_TEST_SEED=$(MSX2_TEST_SEED) MSX2_TEST_FIXTURE=$(MSX2_TEST_FIXTURE) \
	    node $(BUILD_JS)
	MSX2_PLUS=$(MSX2_PLUS) python3 tools/msx2/pack_msx_rom.py $(ROM)
	@ls -l $(ROM)

verify: rom
	./msx2.sh verify --frames $(FRAMES)

# The soak ROM.  Identical to the shipping one except that the player's turn is
# played by the AI, so a headless run finishes whole duels with no input --
# which is the only way the M1a evidence survives now that the duel is a screen
# a human drives.  The object tree is dropped first because MSXgl's incremental
# compile does not know about a changed -D.
soak:
	rm -rf $(OUT_DIR)
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) rom MSX2_AUTOPLAY=1 \
		MSX2_TEST_SEED=$(or $(MSX2_TEST_SEED),0x534F414B)

# Story progression soak.  Full AI duels belong to `soak`; this variant crosses
# the real story fight boundary as a win so rewards, passwords, five-duel
# progression and the ending are deterministic without synthetic input.
story-soak:
	rm -rf $(OUT_DIR)
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) rom MSX2_AUTOPLAY=1 MSX2_STORY_AUTOPLAY=1 \
		MSX2_TEST_SEED=$(or $(MSX2_TEST_SEED),0x53544F52)

# The regression ROM keeps the same real input path as shipping, but exposes
# the versioned probe diagnostics and accepts a fixed seed/fixture.  It is a
# separate variant because MSXgl does not notice changed -D flags in its
# incremental object tree.
regression:
	rm -rf $(OUT_DIR)
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) rom MSX2_REGRESSION=1 \
		MSX2_TEST_SEED=$(or $(MSX2_TEST_SEED),0x1234ABCD) \
		MSX2_TEST_FIXTURE=$(or $(MSX2_TEST_FIXTURE),0)

# ── The MSX2+ cartridge ──────────────────────────────────────────────────────
#
# The same game, with every 2-D picture screen re-encoded for the V9958's YJK
# mode: SCREEN 10, a brightness per pixel and a hue per group of four, with the
# interface drawn in the 16-colour YAE half of the same byte so a word never
# takes its colour from the painting beside it.  The duel stays in GRAPHIC 7 --
# it is rasterised live, and its card textures are shared with the hand.
#
# It is a separate cartridge, not a runtime check: the pictures ARE the
# difference, and one ROM cannot hold both encodings of all of them.  The only
# asset it adds rather than replaces is the YJK copy of the 40x48 thumbnails
# the story's own screens draw, which is why it needs the next ROM size up.
PLUS_ROM     := $(OUT_DIR)/waifu_msx2p.rom
PLUS_ASSETS  := $(PROJ_DIR)/assets/plus/manifest_plus.txt

plus-assets: $(PLUS_ASSETS)

$(PLUS_ASSETS): tools/msx2/gen_msx_plus.py tools/msx2/msx2_yjk.py \
        tools/msx2/gen_msx_scenes.py src/generated/msx2_scenes.h \
        assets/source/msx2/title256_msx2plus.png \
        assets/source/msx2/ending256x212_msx2plus.png
	python3 tools/msx2/gen_msx_plus.py

plus: $(PLUS_ASSETS)
	rm -rf $(OUT_DIR)
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) rom MSX2_PLUS=1 ROM_SIZE_KB=8192
	cp $(ROM) $(PLUS_ROM)
	@ls -l $(PLUS_ROM)

clean:
	rm -rf $(OUT_DIR) $(PROJ_DIR)/emul $(PROJ_DIR)/lib
